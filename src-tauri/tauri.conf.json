{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clicadre",
  "version": "0.1.0",
  "identifier": "io.github.abg5f.clicadre",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "Clicadre",
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": true,
        "backgroundColor": "#000000"
      },
      {
        "label": "editor",
        "url": "editor.html",
        "title": "Clicadre",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "visible": false,
        "decorations": false,
        "backgroundColor": "#18191c"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "category": "Utility",
    "shortDescription": "Capture d'écran avec floutage, annotations et fonds élégants",
    "longDescription": "Clicadre capture une zone de l'écran, permet de flouter et d'entourer des éléments, puis pose la capture sur un fond soigné avant de la copier ou de l'enregistrer.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["French", "English"], "displayLanguageSelector": false }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
